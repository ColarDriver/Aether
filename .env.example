# Aether environment example
# Copy to .env and fill in credentials.

# Global default provider family. Used by the TUI/session default and by
# task subagents when they do not receive an explicit model override.
# codex -> provider=codex, default model=gpt-5.4
# claude -> provider=claude, default model=claude-sonnet-4-6
# openai-compatible -> provider=openai-compatible, default model=AETHER_MODEL
AETHER_PROVIDER=openai-compatible

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
AETHER_MODEL=gpt-4o-mini

# Anthropic provider
ANTHROPIC_API_KEY=

# Optional provider-specific keys
CODEX_ACCESS_TOKEN=
CODEX_API_KEY=
NOUS_API_KEY=

# Optional local web_search backend for OpenAI-compatible/local search.
# WEB_SEARCH_PROVIDER supports: brave, tavily, bocha.
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=

# Runtime mode
AETHER_ENV=development
